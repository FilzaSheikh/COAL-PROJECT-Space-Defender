INCLUDE Irvine32.inc

MAX_BULLETS   = 8
MAX_ENEMIES   = 6
MAX_LIVES     = 5
PLAYER_Y      = 21
TOP_ROW       = 2
PLAYER_MIN    = 2
PLAYER_MAX    = 57
FRAME_MS      = 40
NAME_MAX      = 15
FILE_BUF_SIZE = 4096
SHOW_RECORDS  = 15
KEY_LEFT      = 25h
KEY_RIGHT     = 27h

SHOWLINE MACRO rowN, colN, clr, txt
    mov dh, rowN
    mov dl, colN
    mov bl, clr
    mov esi, OFFSET txt
    call PrintAt
ENDM

.data
