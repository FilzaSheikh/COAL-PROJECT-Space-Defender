tS2 BYTE "/ ___| |  _ \    / \    / ___|| ____|",0
tS3 BYTE "\___ \ | |_) |  / _ \  | |    |  _|  ",0
tS4 BYTE " ___) ||  __/ / ___ \ | |___ | |___ ",0
tS5 BYTE "|____/ |_|    /_/   \_\ \____||_____|",0
tSub BYTE "~ ~ ~   D  E  F  E  N  D  E  R   ~ ~ ~",0
tShip1 BYTE "/A\",0
tShip2 BYTE "/_|_\",0
mOpt1 BYTE "1.  Start Game",0
mOpt2 BYTE "2.  Instructions",0
mOpt3 BYTE "3.  High Scores",0
mOpt4 BYTE "4.  Exit",0
mPrompt BYTE "Enter your choice (1-4): ",0
mHigh BYTE "Current High Score: ",0
msgInvalid BYTE "Invalid choice! Please press 1, 2, 3 or 4.",0

iTitle BYTE "=== INSTRUCTIONS ===",0
iL1 BYTE "Defend space! Destroy the enemies before they hit your ship.",0
iL2 BYTE "A / Left Arrow   : move left",0
iL3 BYTE "D / Right Arrow  : move right",0
iL4 BYTE "SPACE            : fire bullets",0
iL5 BYTE "ESC              : quit the current game",0
